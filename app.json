{
  "expo": {
    "name": "AVISO",
    "slug": "aviso-mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/aviso-logo-android/play_store_512.png",
    "scheme": "avisomobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "AVISO uses the camera to detect road hazards.",
        "NSLocationWhenInUseUsageDescription": "AVISO tracks your location during trips.",
        "NSContactsUsageDescription": "Select emergency contacts from your contacts list.",
        "NSMicrophoneUsageDescription": "Required by the camera.",
        "NSPhotoLibraryUsageDescription": "AVISO needs access to your photos to set a profile picture.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "10.231.217.5": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": false
            }
          }
        }
      }
    },
    "android": {
      "package": "com.nexsmoshi.avisomobile",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.SEND_SMS",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/aviso-logo-android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundImage": "./assets/images/aviso-logo-android/res/mipmap-xxxhdpi/ic_launcher_background.png",
        "monochromeImage": "./assets/images/aviso-logo-android/res/mipmap-xxxhdpi/ic_launcher_monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/aviso-logo-android/play_store_512.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "AVISO uses the camera to detect road hazards."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AVISO tracks your location during trips."
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "AVISO needs access to your photos to set a profile picture."
        }
      ],
      [
        "@kartik512/react-native-uvc-camera",
        {
          "cameraPermissionText": "AVISO uses the camera to detect road hazards."
        }
      ],
      "@rnmapbox/maps",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so"
              ]
            }
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "29bc57a7-8dd4-4bf4-aa49-bfd537dde12c"
      }
    },
    "owner": "nexsmoshi",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/29bc57a7-8dd4-4bf4-aa49-bfd537dde12c",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    }
  }
}
